[Unit]
Description=Worker Agent - Container rental HTTP API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User={{ worker_agent_user }}
Group={{ worker_agent_user }}
WorkingDirectory={{ project_dir }}/containers/agent
EnvironmentFile=/etc/worker-agent.env
ExecStart={{ project_dir }}/containers/agent/venv/bin/python3 {{ project_dir }}/containers/agent/worker_agent.py
Restart=on-failure
RestartSec=5

# Durcissement systemd
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
